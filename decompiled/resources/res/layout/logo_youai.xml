<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout2"
    android:background="@color/appWhite"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView_youai_logo"
        android:background="@color/appWhite"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/logo_youai"
        android:scaleType="centerCrop"
        android:layout_centerInParent="true"
        android:contentDescription="@string/app_name"/>
    <SurfaceView
        android:id="@+id/surfaceView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="0dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <FrameLayout
        android:id="@+id/youai_logo_waiting"
        android:background="#000f0f0f"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ProgressBar
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/youai_waiting_progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ff0d0d0d"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/youai_waiting_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/sdk_init"/>
    </FrameLayout>
</RelativeLayout>
