<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reset_password"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rp_title"
        android:background="@drawable/pp_title_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/rp_back_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/back_margin_left"
            android:src="@drawable/pp_btn_back_selector"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/title_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/rp_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rp_account"
        android:background="@drawable/pu_input_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_below="@+id/rp_title">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/rp_username_iv"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pu_username"/>
            <EditText
                android:textSize="@dimen/btn_text_size"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:id="@+id/rp_username_et"
                android:background="@null"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_toRightOf="@+id/rp_username_iv"
                android:layout_alignTop="@+id/rp_username_iv"
                android:layout_alignBottom="@+id/rp_username_iv"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/rp_arrow_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:src="@drawable/pu_arrow"
                android:layout_alignTop="@+id/rp_username_iv"
                android:layout_alignBottom="@+id/rp_username_iv"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/pu_input_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:padding="10dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pu_password"/>
            <EditText
                android:textSize="@dimen/btn_text_size"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:id="@+id/rp_password_et"
                android:background="@null"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:inputType="textPassword"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/pu_input_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:padding="10dp"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pu_password"/>
            <EditText
                android:textSize="@dimen/btn_text_size"
                android:textColor="@android:color/white"
                android:textColorHint="@android:color/white"
                android:id="@+id/rp_new_password_et"
                android:background="@null"
                android:paddingLeft="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:inputType="textPassword"/>
        </RelativeLayout>
    </LinearLayout>
    <Button
        android:textSize="@dimen/btn_text_size"
        android:textColor="@android:color/white"
        android:id="@+id/rp_reset_btn"
        android:background="@drawable/pu_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/rp_account"/>
    <ImageView
        android:id="@+id/rp_cloud"
        android:background="@drawable/pu_bg_cloud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
